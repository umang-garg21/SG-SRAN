{
  "dataset_root": "/data/warren/materials/EBSD/IN718_FZ_2D_SR_x4",
  "epochs": 40,
  "batch_size": 8,
  "lr": 0.0003,
  "scale": 4,
  "symmetry_group": "O",
  "loss": "bunge_symmetry_misorientation",
  "quaternion_convention": "bunge_passive_wxyz",
  "loss_symmetry_grad_weight": 0.0,
  "amp": false,
  "clip": 1.0,
  "vis_every": 2,
  "num_workers": 0,
  "preload": true,
  "preload_torch": true,
  "pin_memory": true,
  "scheduler": {
    "type": "cosine",
    "warmup_epochs": 3,
    "min_lr": 1e-06
  },
  "optimizer": {
    "type": "AdamW",
    "weight_decay": 0.0001
  },
  "model": {
    "type": "invariant_autoencoder_bunge",
    "dropout": 0.0
  },
  "latent_dim": 32,
  "encoder_hidden_dim": 128,
  "encoder_layers": 3,
  "decoder_hidden_dim": 128,
  "decoder_layers": 3,
  "decoder_dropout": 0.0,
  "canonicalize_output": true,
  "logging": {
    "tensorboard": true,
    "save_best_only": true,
    "val_freq": 1
  },
  "smoke_test": false,
  "save_every": 10
}
